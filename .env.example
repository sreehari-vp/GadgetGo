# Existing local PostgreSQL database. Do not commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/gadgetgo
DB_USERNAME=your_local_database_username
DB_PASSWORD=replace_with_your_local_password

# Non-secret URL used by Vite in the browser.
VITE_API_BASE_URL=http://localhost:8080/api

# Server-side account and browser security settings.
BCRYPT_STRENGTH=12
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Optional local-only provider demo seeding (requires SPRING_PROFILES_ACTIVE=local).
# Disabled by default. Set credentials only in your ignored local .env or process environment.
DEMO_ACCOUNTS_ENABLED=false
# Shared password for all demo accounts (must be 10–72 characters; never commit real passwords):
DEMO_DEFAULT_PASSWORD=
# Optional overrides for default technician accounts (1 to 5):
# DEMO_TECH1_EMAIL=alex.rivera@gadgetgo.local
# DEMO_TECH1_PASSWORD=
# DEMO_TECH2_EMAIL=sam.chen@gadgetgo.local
# DEMO_TECH3_EMAIL=jordan.taylor@gadgetgo.local
# DEMO_TECH4_EMAIL=morgan.patel@gadgetgo.local
# DEMO_TECH5_EMAIL=casey.kim@gadgetgo.local
# Optional overrides for default supplier accounts (1 to 5):
# DEMO_SUPP1_EMAIL=marcus.vance@gadgetgo.local
# DEMO_SUPP1_PASSWORD=
